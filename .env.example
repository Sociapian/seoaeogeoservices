# Public site URL (no trailing slash). Used for canonical URLs, sitemap and schema.
NEXT_PUBLIC_SITE_URL=https://seoaeogeoservices.com

# REQUIRED in production. Signs audit results so the report endpoint only renders
# results this server produced. Generate with: openssl rand -hex 32
AUDIT_SECRET=

# ---------------------------------------------------------------------------
# 1) Whole-site crawl
# ---------------------------------------------------------------------------
CRAWL_MAX_PAGES=25        # 1-50 pages per audit
CRAWL_BUDGET_MS=30000     # stop queuing new pages after this many ms

# ---------------------------------------------------------------------------
# 2) Speed: Google PageSpeed Insights (free).
#    Key: https://developers.google.com/speed/docs/insights/v5/get-started
#    Works without a key but Google's anonymous quota is very small.
# ---------------------------------------------------------------------------
PAGESPEED_API_KEY=

# ---------------------------------------------------------------------------
# 3) AI visibility: configure one or both. Leave both empty to switch it off
#    (the audit then shows "Not available" and re-weights the score).
#    Each audit makes about 9 paid API calls in total.
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
OPENAI_REASONING_EFFORT=low   # set to "none" for models without reasoning
PERPLEXITY_API_KEY=
PERPLEXITY_PRESET=fast
AI_COUNTRY=IN                 # market the buyer questions are written for
AI_DAILY_LIMIT=100            # max AI checks per day per server instance (cost cap)

# ---------------------------------------------------------------------------
# 4) Email: SMTP (Google Workspace, Zoho, Amazon SES, Brevo, SendGrid SMTP, etc.)
# ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="SEO AEO GEO Services <reports@seoaeogeoservices.com>"

# How the audit PDF reaches the visitor:
#   email    = emailed only (proves the address is real). Default when SMTP is set.
#   both     = downloaded instantly and emailed.
#   download = downloaded only. Used automatically when SMTP is not set.
REPORT_DELIVERY=email
REPORT_BCC=web@sociapa.com                   # optional: copy every report to your team
REQUIRE_BUSINESS_EMAIL=0      # 1 = reject Gmail/Yahoo/Outlook etc. for audit reports

# ---------------------------------------------------------------------------
# Lead delivery (contact form + audit leads). Configure at least one.
# ---------------------------------------------------------------------------
LEAD_WEBHOOK_URL=             # every lead POSTed as JSON (Zapier, Make, Sheets, CRM)
LEAD_NOTIFY_TO=web@sociapa.com     # default if unset: site.contact.email
LEAD_FILE_LOG=1               # appends to .data/leads.jsonl; set 0 on Vercel

# ---------------------------------------------------------------------------
# 5) Google reCAPTCHA v3: Robot protection for all forms
#    Get keys: https://www.google.com/recaptcha/admin/create (reCAPTCHA v3)
#    (Leave empty to bypass verification in local development)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
RECAPTCHA_MIN_SCORE=0.5

# Development only: allow auditing localhost / private IPs. Never enable in production.
AUDIT_ALLOW_PRIVATE=0
# Optional API base URL overrides (gateways / local mocks)
# PAGESPEED_API_URL=
# OPENAI_BASE_URL=
# PERPLEXITY_BASE_URL=
